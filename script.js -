// SpendWise - JavaScript Foundation
console.log("SpendWise Loaded Successfully");

// 2. STORE APPLICATION DATA - Variables
let monthlyIncome = 0;
let totalExpenses = 0;
let remainingBalance = 0;
let savingsPercentage = 0;

// Array to store all expenses - Data Structure requirement
let expenses = [];
let expenseNames = ["Rent", "Food", "Transport", "Entertainment"];

const APP_NAME = "SpendWise";
const CURRENCY = "KES";

// 5. REUSABLE FUNCTIONS
function calculateTotalExpenses(expensesArray) {
    // Looping requirement - sum using for loop
    let total = 0;
    for (let i = 0; i < expensesArray.length; i++) {
        total += expensesArray[i];
    }
    return total;
}

function calculateRemainingBalance(income, expenses) {
    return income - expenses;
}

function calculateSavingsPercentage(balance, income) {
    if (income === 0) return 0;
    return (balance / income) * 100;
}

function getBudgetStatus(balance) {
    // Decision-making / Conditional requirement
    if (balance > 0) {
        return "You are within budget! ✅ - Good job!";
    } else if (balance === 0) {
        return "You broke even ⚖️";
    } else {
        return "OVERSPENDING! ❌ - You spent more than income!";
    }
}

function displayResultsConsole() {
    console.log("========== " + APP_NAME + " REPORT ==========");
    console.log("Monthly Income: " + CURRENCY + " " + monthlyIncome);
    for (let i = 0; i < expenses.length; i++) {
        console.log(expenseNames[i] + ": " + CURRENCY + " " + expenses[i]);
    }
    console.log("------------------------------------");
    console.log("Total Expenses: " + CURRENCY + " " + totalExpenses);
    console.log("Remaining Balance: " + CURRENCY + " " + remainingBalance);
    console.log("Savings: " + savingsPercentage.toFixed(2) + "%");
    console.log("Status: " + getBudgetStatus(remainingBalance));
    console.log("====================================");
}

function displayResultsUI() {
    const resultCard = document.getElementById("resultCard");
    const resultsDiv = document.getElementById("results");
    // Toggle visibility - DOM manipulation
    resultCard.style.display = "block";
    const statusClass = remainingBalance >= 0 ? "positive" : "negative";
    
    let html = "";
    html += `<div class="result-item"><span>Monthly Income</span><span>${CURRENCY} ${monthlyIncome}</span></div>`;
    // Loop to display each expense
    for (let i = 0; i < expenses.length; i++) {
        html += `<div class="result-item"><span>${expenseNames[i]}</span><span>${CURRENCY} ${expenses[i]}</span></div>`;
    }
    html += `<div class="result-item total"><span>Total Expenses</span><span>${CURRENCY} ${totalExpenses}</span></div>`;
    html += `<div class="result-item total ${statusClass}"><span>Remaining Balance</span><span>${CURRENCY} ${remainingBalance} (${savingsPercentage.toFixed(1)}%)</span></div>`;
    html += `<div class="result-item"><span>Status</span><span>${getBudgetStatus(remainingBalance)}</span></div>`;
    
    resultsDiv.innerHTML = html;
}

function startBudgeting() {
    // 3. COLLECT USER INPUT via prompts
    monthlyIncome = Number(prompt("Enter your monthly income (KES):", "50000"));
    expenses = []; // reset array
    for (let i = 0; i < expenseNames.length; i++) {
        let value = Number(prompt("Enter " + expenseNames[i] + " expense (KES):", "5000"));
        if (isNaN(value)) value = 0;
        expenses.push(value); // store in array
    }

    if (isNaN(monthlyIncome)) {
        alert("Please enter valid numbers!");
        return;
    }

    // 4. CALCULATIONS using functions + loop
    totalExpenses = calculateTotalExpenses(expenses);
    remainingBalance = calculateRemainingBalance(monthlyIncome, totalExpenses);
    savingsPercentage = calculateSavingsPercentage(remainingBalance, monthlyIncome);

    // 6. DISPLAY RESULTS
    displayResultsConsole();
    displayResultsUI();
    alert("Calculated! Remaining: " + CURRENCY + " " + remainingBalance + " - Check Console (F12)");
}

// Event Listener - attaches click listener to start button
document.addEventListener("DOMContentLoaded", () => {
    console.log("DOM Loaded - SpendWise Ready");
    document.getElementById("startBtn").addEventListener("click", startBudgeting);
});
